<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.StreamActivity">

    <!-- Custom Toolbar for Edge-to-Edge Support -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="#80000000"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Container Spatial ToF (Aspect Ratio 4:3) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tofContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ToF 8x8 Grid Overlay (1:1 ratio, full width, centered) -->
        <GridLayout
            android:id="@+id/gridTof"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:columnCount="8"
            android:rowCount="8"
            android:visibility="visible"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Clock Direction Indicator (10 - 2) mapped across pixel width -->
        <LinearLayout
            android:id="@+id/clockDirectionIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="8"
            android:background="#40000000"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvClock10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="10"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Garis tipis hijau — batas zona 10|11 -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#AA00C853" />

            <TextView
                android:id="@+id/tvClock11"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="center"
                android:text="11"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Garis tipis hijau — batas zona 11|12 -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#AA00C853" />

            <TextView
                android:id="@+id/tvClock12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="center"
                android:text="12"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Garis tipis hijau — batas zona 12|1 -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#AA00C853" />

            <TextView
                android:id="@+id/tvClock1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Garis tipis hijau — batas zona 1|2 -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#AA00C853" />

            <TextView
                android:id="@+id/tvClock2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- IMU / EKF Data & Latency Monitor Panels (Top Left) -->
    <LinearLayout
        android:id="@+id/layoutImu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:orientation="vertical">

        <!-- IMU / EKF Data Panel — lebih prominent -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#CC000000"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Label judul panel -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● MAHONY AHRS / MPU6050"
                android:textColor="#4FC3F7"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvImuPitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pitch:  0.0°"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="monospace" />
            <TextView
                android:id="@+id/tvImuRoll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roll:   0.0°"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="monospace" />
            <TextView
                android:id="@+id/tvImuPitchRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pitch Rate: 0.0°/s"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="monospace" />
            <TextView
                android:id="@+id/tvImuRollRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roll Rate:  0.0°/s"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="monospace" />
            <TextView
                android:id="@+id/tvImuYaw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yaw:    0.0°"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="monospace" />
            <TextView
                android:id="@+id/tvImuAccel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accel:  0.00 m/s²"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Latency Monitor Panel dipindah ke root FrameLayout di bawah -->
    </LinearLayout>

    <!-- Latency Monitor Panel (Top Right) -->
    <LinearLayout
        android:id="@+id/layoutLatencyMonitor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:orientation="vertical"
        android:background="#80000000"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvLatencyMonitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="9sp"
            android:fontFamily="sans-serif-light"
            android:text="Total Latency: 0 ms" />
    </LinearLayout>

    <!-- Overlay: Status + Controls (bottom) -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#80000000">

        <!-- Badge koneksi + Tombol Akhiri tersembunyi (geser untuk tampilkan) -->
        <FrameLayout
            android:id="@+id/badgeSwipeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp">

            <!-- Tombol Akhiri (tersembunyi di balik badge, muncul saat digeser) -->
            <Button
                android:id="@+id/btnAkhiriBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:text="Akhiri"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#D32F2F"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />

            <!-- Badge koneksi utama -->
            <TextView
                android:id="@+id/tvConnectedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="&#9679; Menerima data dari ESP32-S3  ‹ geser"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="#AA000000"
                android:visibility="gone" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/progressStream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStreamStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mencari VNetra..."
            android:textColor="#888888"
            android:textAlignment="center"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF5252"
            android:textAlignment="center"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />


        <!-- Baris tombol: Reconnect + Mode Dataset + Akhiri -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnReconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reconnect"
                android:visibility="gone" />



            <Button
                android:id="@+id/btnAkhiri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Akhiri"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D32F2F" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
